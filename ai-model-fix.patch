+'use client'
+
+import { Suspense, useEffect, useState } from 'react'
+import { useRouter, useSearchParams } from 'next/navigation'
+import { createClient } from '@/lib/supabase/client'
+
+type School = {
+  id: string
+  slug: string
+  name: string
+  tagline: string | null
+  price_kobo: number
+  features: string[]
+}
+
+function formatNaira(kobo: number) {
+  return `₦${(kobo / 100).toLocaleString('en-NG')}`
+}
+
+function BrowseContent() {
+  const router = useRouter()
+  const searchParams = useSearchParams()
+  const email = searchParams.get('email') || ''
+
+  const [schools, setSchools] = useState<School[]>([])
+  const [loading, setLoading] = useState(true)
+
+  useEffect(() => {
+    if (!email) router.push('/register')
+  }, [email, router])
+
+  useEffect(() => {
+    async function load() {
+      const supabase = createClient()
+      const { data, error } = await supabase
+        .from('schools')
+        .select('id, slug, name, tagline, price_kobo, features')
+        .eq('is_active', true)
+        .order('order_index')
+
+      if (!error && data) setSchools(data as School[])
+      setLoading(false)
+    }
+    load()
+  }, [])
+
+  function selectSchool(slug: string) {
+    router.push(`/payment?email=${encodeURIComponent(email)}&school=${slug}`)
+  }
+
+  if (!email) return null
+
+  return (
+    <div>
+      <div className="mb-6">
+        <h2 className="text-3xl font-black text-[#1E293B] tracking-tight mb-2">Choose Your School</h2>
+        <p className="text-sm font-medium text-[#8B7355]">
+          Pick the Bearilly track that fits you. You can only see content for the school you join.
+        </p>
+      </div>
+
+      {loading && (
+        <div className="space-y-3">
+          {[1, 2].map(i => (
+            <div key={i} className="h-32 bg-[#F8F5EF] rounded-xl animate-pulse" />
+          ))}
+        </div>
+      )}
+
+      {!loading && schools.length === 0 && (
+        <div className="text-center py-10 text-sm font-semibold text-admin-slate/60">
+          No schools are available right now. Please check back soon.
+        </div>
+      )}
+
+      <div className="space-y-4">
+        {schools.map(school => (
+          <button
+            key={school.id}
+            onClick={() => selectSchool(school.slug)}
+            className="w-full text-left bg-white border border-[#E8E0D0] rounded-xl p-5 transition-all hover:shadow-lg hover:border-[#C89B5A] group"
+          >
+            <div className="flex items-start justify-between gap-4">
+              <div className="flex-1">
+                <p className="font-black text-lg tracking-tight text-[#2D2416] group-hover:text-[#C89B5A] transition-colors">
+                  {school.name}
+                </p>
+                {school.tagline && (
+                  <p className="text-sm font-medium text-[#8B7355] mt-1">{school.tagline}</p>
+                )}
+                <ul className="mt-3 space-y-1">
+                  {(school.features || []).slice(0, 3).map(f => (
+                    <li key={f} className="text-xs font-semibold text-[#4F7C82] flex items-center gap-1.5">
+                      <span className="text-[10px]">●</span> {f}
+                    </li>
+                  ))}
+                </ul>
+              </div>
+              <div className="text-right shrink-0">
+                <p className="text-2xl font-black text-admin-teal">{formatNaira(school.price_kobo)}</p>
+                <p className="text-xs font-bold text-user-gold mt-0.5">Select →</p>
+              </div>
+            </div>
+          </button>
+        ))}
+      </div>
+    </div>
+  )
+}
+
+export default function BrowsePage() {
+  return (
+    <Suspense fallback={<div className="text-center py-8 text-admin-slate/60 text-sm font-semibold animate-pulse">Loading schools...</div>}>
+      <BrowseContent />
+    </Suspense>
+  )
+}
